# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database (docker compose builds DATABASE_URL from the MYSQL_* values) ---
MYSQL_DATABASE=algo_trading
MYSQL_USER=algo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Used when running the backend outside docker:
DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/algo_trading
REDIS_URL=redis://localhost:6379/0

# --- Host ports published by docker compose ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Generate with: openssl rand -hex 32
SECRET_KEY=
AUTH_ENABLED=true
ALLOW_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Trading safety. Default is PAPER. Live trading needs ALL of the following: ---
#   TRADING_MODE=LIVE, ENABLE_LIVE_TRADING=true,
#   LIVE_TRADING_CONFIRMATION=I-ACCEPT-REAL-MONEY-RISK,
#   and a LIVE broker account explicitly armed in the database (see README).
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

# --- Market data: simulated | dhan | zerodha ---
MARKET_DATA_PROVIDER=simulated
SIMULATED_MARKET_24X7=true

# --- Paper broker ---
PAPER_INITIAL_CAPITAL=500000
PAPER_SLIPPAGE_PCT=0.0005
PAPER_MAX_FILL_QTY_PER_TICK=0

# --- Risk defaults (seed the risk configuration row on first start) ---
MAX_DAILY_LOSS=5000
MAX_RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=20
MAX_POSITION_SIZE=5000
MAX_ORDER_VALUE=500000
MAX_CONSECUTIVE_LOSSES=5
MAX_STRATEGY_DRAWDOWN=0.10

# --- Workers ---
RUN_WORKERS=true
STRATEGY_POLL_SECONDS=10
ORDER_MONITOR_POLL_SECONDS=3
MARKET_DATA_POLL_SECONDS=3

# --- Brokers (all optional; the app runs without any of them) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_SANDBOX_BASE_URL=https://sandbox.dhan.co/v2
DHAN_LIVE_BASE_URL=https://api.dhan.co/v2

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
